{
  "model": "openai/deepseek-v4-flash",
  "max_steps": 150,
  "api_base": "https://api.deepseek.com",
  "api_key_env": "DEEPSEEK_API_KEY",
  "extra_args": {
    "allowed_openai_params": [
      "reasoning_effort"
    ],
    "reasoning_effort": "max",
    "max_tokens": 262144,
    "stream": false,
    "extra_body": {
      "thinking": {
        "type": "enabled"
      }
    }
  }
}
